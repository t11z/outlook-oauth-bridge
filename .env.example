# --- Microsoft OAuth ---------------------------------------------
# Application (client) ID der Azure App-Registrierung.
# Kontotypen: "nur persönliche Microsoft-Konten"
# Authentifizierung -> "Allow public client flows" = JA
BRIDGE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Wird beim Device Code Flow NICHT benötigt. Nur setzen, wenn
# "Allow public client flows" nicht aktiviert werden kann.
#BRIDGE_CLIENT_SECRET=

# --- Netzwerk ----------------------------------------------------
# Nur der Startwert beim allerersten Start (landet dann in state.json).
# Danach ist die GUI (Settings -> SMTP listen port) massgeblich.
#BRIDGE_SMTP_PORT=2525
#BRIDGE_HTTP_PORT=8080
#BRIDGE_BIND=0.0.0.0
#BRIDGE_TRUST_TLS=1        # setzen, wenn ein TLS-Reverse-Proxy davor steht
# Nur nötig, wenn requireTls (SMTP STARTTLS) in der GUI aktiviert wird.
# Ohne echte Zertifikate faellt smtp-server sonst auf ein selbstsigniertes
# Bordmittel-Zertifikat zurueck, das viele Altgeraete ablehnen.
#BRIDGE_TLS_KEY=/path/to/privkey.pem
#BRIDGE_TLS_CERT=/path/to/fullchain.pem

# --- Betrieb -----------------------------------------------------
#BRIDGE_DATA_DIR=/data
#BRIDGE_RESET_PASSWORD=1   # einmalig: GUI-Passwort neu erzeugen und loggen
#BRIDGE_LOG_LEVEL=info

# --- Nur für Tests -------------------------------------------------
#BRIDGE_GRAPH_BASE=https://graph.microsoft.com/v1.0
#BRIDGE_LOGIN_BASE=https://login.microsoftonline.com/consumers/oauth2/v2.0
